APP_NAME=Hospital AI Assistant
APP_ENV=development

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/hospital_ai

JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

UPLOAD_DIR=data/storage
KNOWLEDGE_BASE_PATH=data/knowledge_base

VECTOR_INDEX_PATH=data/vector_index/index.faiss
VECTOR_METADATA_PATH=data/vector_index/metadata.json

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

LLM_PROVIDER=retrieval_only

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

ADMIN_EMAIL=admin@pulsepoint.health
ADMIN_PASSWORD=change-this-password

MAX_UPLOAD_SIZE_MB=10
